{
  "name": "anniversary-invite",
  "version": "1.0.0",
  "private": true,
  "description": "10th Anniversary digital invitation - personalised, static, bilingual (fa/en)",
  "scripts": {
    "generate-invites": "node scripts/generate-invites.mjs",
    "dev": "npm run generate-invites && next dev",
    "prebuild": "npm run generate-invites",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.24"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
